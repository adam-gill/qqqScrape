{
  "name": "qqq-scraper",
  "version": "1.0.0",
  "description": "API to fetch QQQ ETF holdings",
  "scripts": {
    "dev": "ts-node server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "restart": "docker compose down && docker compose up -d --build && docker compose logs -f",
    "flush-cache": "docker compose down -v"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "puppeteer": "^24.37.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
